# Maintainer: Kushagra Kumar (kk376) <kkushagra86@gmail.com>
pkgname=kktypr
pkgver=0.3.0
pkgrel=1
pkgdesc="Terminal touch typing academy and developer syntax trainer in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/kk376/kktypr"
license=('MIT' 'Apache-2.0')
depends=('glibc')
makedepends=('cargo' 'rust')
install=kktypr.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/kk376/kktypr/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('34ca5fc0e33d069368a0fd0a13cac242b31c2aa7c075859274e87735aef39d56')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    if [ -f "docs/$pkgname.1" ]; then
        install -Dm644 "docs/$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
    fi
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
