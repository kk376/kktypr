#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	sed -i -e 's/edition = "2024"/edition = "2021"/' -e '/rust-version/d' Cargo.toml
	sed -i 's/^version = 4$$/version = 3/' Cargo.lock || true
	find vendor -name Cargo.toml -exec sed -i -e 's/edition = "2024"/edition = "2021"/' -e '/rust-version/d' {} +
	find vendor -name "*.rs" -exec sed -i 's/pub const fn height(&self)/pub fn height(&self)/g' {} +
	cargo build --release --locked --offline

override_dh_auto_test:
	./target/release/kktypr --version

override_dh_auto_install:
	install -d debian/kktypr/usr/bin
	install -m 0755 target/release/kktypr debian/kktypr/usr/bin/kktypr
	install -d debian/kktypr/usr/share/man/man1
	if [ -f docs/kktypr.1 ]; then \
		gzip -9cn docs/kktypr.1 > debian/kktypr/usr/share/man/man1/kktypr.1.gz; \
	fi
	install -d debian/kktypr/usr/share/doc/kktypr
	install -m 0644 README.md debian/kktypr/usr/share/doc/kktypr/README.md

override_dh_auto_clean:
	cargo clean || true
	dh_auto_clean
